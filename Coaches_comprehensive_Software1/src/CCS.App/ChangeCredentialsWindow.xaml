<Window x:Class="CCS.App.ChangeCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="تغییر مشخصات" Height="512" Width="480" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" FlowDirection="RightToLeft" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#D0D3DC" BorderThickness="1" Background="#F5F6FA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="icon.png" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock Text="تغییر مشخصات" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="—" Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeBtn" Content="□" Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Maximize_Click"/>
                    <Button Content="×" Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="نام کاربری فعلی" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,6"/>
                <TextBox x:Name="CurrentUsernameBox" Grid.Row="1" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" FlowDirection="LeftToRight"/>
                <TextBlock Grid.Row="2" Text="رمز عبور فعلی" FontSize="13" Foreground="#2C3E50" Margin="0,12,0,6"/>
                <PasswordBox x:Name="CurrentPasswordBox" Grid.Row="3" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" FlowDirection="LeftToRight"/>
                <TextBlock Grid.Row="4" Text="نام کاربری جدید (اختیاری)" FontSize="13" Foreground="#2C3E50" Margin="0,12,0,6"/>
                <TextBox x:Name="NewUsernameBox" Grid.Row="5" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" FlowDirection="LeftToRight"/>
                <TextBlock Grid.Row="6" Text="رمز عبور جدید (اختیاری)" FontSize="13" Foreground="#2C3E50" Margin="0,12,0,6"/>
                <PasswordBox x:Name="NewPasswordBox" Grid.Row="7" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" FlowDirection="LeftToRight"/>
                <TextBlock Grid.Row="8" Text="تکرار رمز عبور جدید" FontSize="13" Foreground="#2C3E50" Margin="0,12,0,6"/>
                <PasswordBox x:Name="ConfirmNewPasswordBox" Grid.Row="9" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" FlowDirection="LeftToRight"/>
                <StackPanel Grid.Row="10" Margin="0,14,0,0">
                    <TextBlock x:Name="ErrorText" Foreground="#C50F1F" FontSize="12" TextWrapping="Wrap"/>
                    <Button Content="تایید" Height="38" Margin="0,10,0,0" Background="#1F6FEB" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="ConfirmButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>