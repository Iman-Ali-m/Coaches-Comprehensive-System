<Window x:Class="CCS.App.CoachFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فرم‌ها و مدارک سازمانی"
        Height="750"
        Width="1000"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F6FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="اطلاعات فرم مربی" FontSize="16" FontWeight="SemiBold" Foreground="#1F6FEB" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                        <TextBlock Text="سطح مربی" FontSize="12" Foreground="#2C3E50"/>
                        <TextBox x:Name="CoachLevelBox" Height="30" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                        <TextBlock Text="پایه مربی" FontSize="12" Foreground="#2C3E50"/>
                        <TextBox x:Name="CoachBaseBox" Height="30" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                        <TextBlock Text="شماره پرونده فیزیکی" FontSize="12" Foreground="#2C3E50"/>
                        <TextBox x:Name="PhysicalFileNumberBox" Height="30" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                        <TextBlock Text="وضعیت همکاری" FontSize="12" Foreground="#2C3E50"/>
                        <ComboBox x:Name="CollaborationStatusCombo" Height="30" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                
                <TextBlock Text="آپلود مدارک سازمانی (تک فایل)" FontSize="16" FontWeight="SemiBold" Foreground="#1F6FEB" Margin="0,20,0,10"/>
                <WrapPanel>
                    <StackPanel Margin="4,0,0,10" Width="220">
                        <Button Content="عمومی رسمی" Height="30" Click="UploadPublicOfficialBtn_Click"/>
                        <TextBlock x:Name="PublicOfficialText" Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,10" Width="220">
                        <Button Content="تبدیل عضویت" Height="30" Click="UploadMembershipConversionBtn_Click"/>
                        <TextBlock x:Name="MembershipConversionText" Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,10" Width="220">
                        <Button Content="مقدماتی رسته‌ای" Height="30" Click="UploadPreliminaryRankBtn_Click"/>
                        <TextBlock x:Name="PreliminaryRankText" Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,10" Width="220">
                        <Button Content="عالی رسته‌ای" Height="30" Click="UploadAdvancedRankBtn_Click"/>
                        <TextBlock x:Name="AdvancedRankText" Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,10" Width="220">
                        <Button Content="آخرین حکم مسئولیت" Height="30" Click="UploadLastPositionOrderBtn_Click"/>
                        <TextBlock x:Name="LastPositionOrderText" Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,10" Width="220">
                        <Button Content="آخرین ابلاغ درجه" Height="30" Click="UploadLastRankDelegationBtn_Click"/>
                        <TextBlock x:Name="LastRankDelegationText" Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,10" Width="220">
                        <Button Content="آخرین ابلاغ رسته" Height="30" Click="UploadLastRankCategoryDelegationBtn_Click"/>
                        <TextBlock x:Name="LastRankCategoryDelegationText" Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,10" Width="220">
                        <Button Content="اسناد پزشکی معافیت" Height="30" Click="UploadMedicalExemptionDocumentsBtn_Click"/>
                        <TextBlock x:Name="MedicalExemptionDocumentsText" Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,10" Width="220">
                        <Button Content="کارتکس (فقط Word)" Height="30" Click="UploadCartexBtn_Click"/>
                        <TextBlock x:Name="CartexText" Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="افزودن عکس‌های فرم (چند فایل)" FontSize="16" FontWeight="SemiBold" Foreground="#1F6FEB" Margin="0,20,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
                    <Button Content="افزودن عکس" Height="30" Width="150" Click="UploadCoachFormPhotoBtn_Click"/>
                </StackPanel>
                <ListBox x:Name="CoachFormPhotosList" Height="100" Margin="4,0,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="ذخیره" Height="36" Width="120" Background="#1F6FEB" Foreground="White" BorderThickness="0" FontSize="14" Cursor="Hand" Click="SaveButton_Click"/>
            <Button Content="انصراف" Height="36" Width="120" Margin="10,0,0,0" Background="#E8EBF2" Foreground="#2C3E50" BorderThickness="0" FontSize="14" Cursor="Hand" Click="CancelButton_Click"/>
            <TextBlock x:Name="ErrorText" Foreground="#C50F1F" FontSize="12" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>