<Window x:Class="CCS.App.CustomFieldManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت ویژگی‌های پویا"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F6FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="تعریف ویژگی جدید" FontSize="16" FontWeight="SemiBold" Foreground="#1F6FEB" Margin="0,0,0,10"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="4" Width="200">
                <TextBlock Text="عنوان ویژگی" FontSize="12"/>
                <TextBox x:Name="TitleBox" Height="30" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Margin="4" Width="150">
                <TextBlock Text="نوع ورودی" FontSize="12"/>
                <ComboBox x:Name="TypeCombo" Height="30" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Margin="4" Width="80">
                <TextBlock Text="حداقل" FontSize="12"/>
                <TextBox x:Name="MinBox" Height="30" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
            </StackPanel>
            <StackPanel Margin="4" Width="80">
                <TextBlock Text="حداکثر" FontSize="12"/>
                <TextBox x:Name="MaxBox" Height="30" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
            </StackPanel>
            <StackPanel Margin="4" Width="150">
                <TextBlock Text="ترتیب نمایش" FontSize="12"/>
                <TextBox x:Name="OrderBox" Height="30" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
            </StackPanel>
            <StackPanel Margin="4" Width="220">
                <TextBlock Text="گزینه‌ها (با کاما جدا کنید)" FontSize="12"/>
                <TextBox x:Name="OptionsBox" Height="30" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Margin="4" Width="180">
                <TextBlock Text="فایل قالب (برای دریافت و بازگرداندن)" FontSize="12"/>
                <Button Content="انتخاب قالب" Height="30" Margin="0,4,0,0" Click="PickTemplateBtn_Click"/>
                <TextBlock x:Name="TemplateText" FontSize="11" Foreground="#2C3E50" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="افزودن ویژگی" Height="30" Width="120" Margin="4,20,0,0" Background="#1F6FEB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="AddFieldBtn_Click"/>
        </WrapPanel>
        <DataGrid Grid.Row="2" x:Name="FieldsGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35" Background="White" BorderBrush="#D0D3DC" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="نوع" Binding="{Binding TypePersian}" Width="*"/>
                <DataGridTextColumn Header="ترتیب" Binding="{Binding DisplayOrder}" Width="80"/>
                <DataGridTemplateColumn Header="حذف" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="حذف" Width="60" Height="24" Background="#E81123" Foreground="White" BorderThickness="0" Cursor="Hand" Click="DeleteFieldBtn_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>